<idea-plugin>
    <id>dev.accessscope.plugin</id>
    <name>AccessScope</name>
    <vendor>AccessScope</vendor>
    <description><![CDATA[
      Install, launch and fetch accessibility scan results from AccessScope on connected Android devices.

      <b>Come usare</b>
      <ul>
        <li><b>Toolbar</b> — icona AccessScope in alto a destra</li>
        <li><b>Tools → AccessScope</b> per il pannello principale</li>
        <li><b>Run → Open AccessScope on Device</b> per installare e aprire l'app sul device</li>
      </ul>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="AccessScope"
            anchor="right"
            factoryClass="dev.accessscope.plugin.AccessScopeToolWindowFactory"
            icon="/icons/access_scope.svg"/>
        <applicationService serviceImplementation="dev.accessscope.plugin.PluginUpdateChecker"/>
    </extensions>

    <actions>
        <action
            id="AccessScope.OpenToolWindow"
            class="dev.accessscope.plugin.OpenToolWindowAction"
            text="AccessScope"
            description="Open AccessScope tool window"
            icon="/icons/access_scope.svg">
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
            id="AccessScope.InstallLaunch"
            class="dev.accessscope.plugin.InstallLaunchAction"
            text="Open AccessScope on Device"
            description="Install or update AccessScope and launch it on the selected device"
            icon="/icons/access_scope.svg">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
