{
  "name": "accessscope",
  "displayName": "AccessScope",
  "description": "Bridge VS Code/Cursor ↔ AccessScope: installa l'APK sul device, apre l'app e recupera i report WCAG in JSON.",
  "version": "1.0.8",
  "publisher": "accessscope",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onView:accessScope.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "accessScope",
          "title": "AccessScope",
          "icon": "media/access-scope.svg"
        }
      ]
    },
    "views": {
      "accessScope": [
        {
          "type": "webview",
          "id": "accessScope.sidebar",
          "name": "AccessScope",
          "icon": "media/access-scope.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "accessScope.openPanel",
        "title": "AccessScope: Open Panel",
        "icon": {
          "light": "media/access-scope.svg",
          "dark": "media/access-scope.svg"
        }
      },
      {
        "command": "accessScope.selectDevice",
        "title": "AccessScope: Select Device",
        "icon": "$(device-mobile)"
      },
      {
        "command": "accessScope.install",
        "title": "AccessScope: Install / Update",
        "icon": "$(cloud-download)"
      },
      {
        "command": "accessScope.launch",
        "title": "AccessScope: Launch",
        "icon": "$(run)"
      },
      {
        "command": "accessScope.installAndLaunch",
        "title": "AccessScope: Install and Launch",
        "icon": "$(run-all)"
      },
      {
        "command": "accessScope.fetchResults",
        "title": "AccessScope: Fetch Results",
        "icon": "$(json)"
      },
      {
        "command": "accessScope.checkSetup",
        "title": "AccessScope: Check Setup",
        "icon": "$(checklist)"
      },
      {
        "command": "accessScope.clearOutput",
        "title": "AccessScope: Clear Output",
        "icon": "$(clear-all)"
      },
      {
        "command": "accessScope.checkExtensionUpdate",
        "title": "AccessScope: Check Extension Update",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "accessScope.openPanel"
        },
        {
          "command": "accessScope.selectDevice"
        },
        {
          "command": "accessScope.install"
        },
        {
          "command": "accessScope.launch"
        },
        {
          "command": "accessScope.installAndLaunch"
        },
        {
          "command": "accessScope.fetchResults"
        },
        {
          "command": "accessScope.checkSetup"
        },
        {
          "command": "accessScope.clearOutput"
        },
        {
          "command": "accessScope.checkExtensionUpdate"
        }
      ]
    },
    "configuration": {
      "title": "AccessScope",
      "properties": {
        "accessScope.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to AccessScope CLI JAR. Empty uses bundled JAR."
        },
        "accessScope.defaultDevice": {
          "type": "string",
          "default": "",
          "description": "Default adb device serial."
        },
        "accessScope.targetPackage": {
          "type": "string",
          "default": "",
          "description": "Target app package for fetch-results. Empty auto-detects from app/build.gradle."
        },
        "accessScope.javaPath": {
          "type": "string",
          "default": "",
          "description": "Java executable for running the CLI JAR."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}
