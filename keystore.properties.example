# Copy to keystore.properties (never commit that file).
# Generate a release keystore locally:
#   keytool -genkey -v -keystore app/release.keystore -alias access-scope \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# For CI, configure GitHub Secrets:
#   RELEASE_KEYSTORE_BASE64, RELEASE_KEYSTORE_PASSWORD,
#   RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD

storeFile=app/release.keystore
storePassword=your-store-password
keyAlias=access-scope
keyPassword=your-key-password
